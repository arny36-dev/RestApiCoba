APP_NAME=RestApiCoba
APP_ENV=local
DEBUG=true

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/database_name
# For MySQL/MariaDB use:
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/database_name?charset=utf8mb4

# API key required in the X-API-Key header on all /employees and
# /employee-types endpoints. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me-to-a-long-random-secret

DEFAULT_OBJECT_ID=127
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

API_PREFIX=/api/v1

LOG_DIR=logs
LOG_SQL=false
